# Copy this file to .env.local. Never commit .env.local or paste real secrets here.
# Leave provider keys blank for the read-only sample storefront.
# Use test credentials until you intentionally complete docs/launch-checklist.md.

# Public: these values may be embedded in browser bundles.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3006
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private Supabase secret (sb_secret_...), or local/legacy service_role key.
SUPABASE_SECRET_KEY=

# Private independent random values. Generate each with the README command.
RATE_LIMIT_SALT=
ORDER_TOKEN_SECRET=
CRON_SECRET=

# Payments: use sk_test_... and the whsec_... for this exact webhook endpoint.
COMMERCE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=true
STRIPE_PRODUCT_TAX_CODE=txcd_30011000

# Shipping: use the EasyPost test API key, not a production key.
EASYPOST_MODE=test
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
# Packed parcel dimensions in inches; per-variant weights are in ounces.
SHIPPING_PARCEL_LENGTH=14
SHIPPING_PARCEL_WIDTH=11
SHIPPING_PARCEL_HEIGHT=3
SHIPPING_PACKAGING_WEIGHT_OZ=2

# Transactional email: sender must belong to a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Thread & Form <orders@example.com>
OWNER_NOTIFICATION_EMAIL=owner@example.com
